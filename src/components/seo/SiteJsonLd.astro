---
import { socialProfiles } from '../../data/social';

interface Props {
	inLanguage?: string;
	description?: string;
}

const { inLanguage = 'en', description } = Astro.props;

const site = Astro.site;
if (!site) {
	return null;
}

const origin = site.origin;
const logoUrl = new URL('/og/default.png', origin).href;
const businessEmail = 'fabian@influentlat.com';

const graph = [
	{
		'@type': 'Organization',
		'@id': `${origin}/#organization`,
		name: 'Influent',
		url: origin,
		...(description ? { description } : {}),
		logo: {
			'@type': 'ImageObject',
			url: logoUrl,
		},
		sameAs: [socialProfiles.instagram],
		areaServed: {
			'@type': 'Country',
			name: 'Costa Rica',
		},
		contactPoint: {
			'@type': 'ContactPoint',
			contactType: 'sales',
			email: businessEmail,
			availableLanguage: ['Spanish', 'English'],
		},
	},
	{
		'@type': 'WebSite',
		'@id': `${origin}/#website`,
		name: 'Influent',
		url: origin,
		inLanguage: ['es', 'en'],
		publisher: { '@id': `${origin}/#organization` },
	},
];

const structuredData = {
	'@context': 'https://schema.org',
	'@graph': graph,
};
---

<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
